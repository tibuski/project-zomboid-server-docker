FROM docker.io/golang:1.26-alpine@sha256:0178a641fbb4858c5f1b48e34bdaabe0350a330a1b1149aabd498d0699ff5fb2 AS builder

WORKDIR /build

COPY go.mod go.sum ./
RUN --mount=type=cache,target=/go/pkg/mod go mod download

COPY . .

RUN --mount=type=cache,target=/go/pkg/mod \
    --mount=type=cache,target=/root/.cache/go-build \
    CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -trimpath -ldflags="-s -w" -o /discordbot ./cmd/discordbot

# docker:cli ships the docker CLI plus the compose and buildx plugins; the
# digest pin above makes the bundled plugin versions reproducible.
FROM docker.io/docker:cli@sha256:000bb62ff495f986c9f5578eb67cc2cb98b91138eda81d7762d5371eb8a497fe

LABEL org.opencontainers.image.title="Project Zomboid Server Discord Restart Bot"
LABEL org.opencontainers.image.description="Watches a Discord channel for 'restart server' and recreates the game service on the latest image"
LABEL org.opencontainers.image.source="https://github.com/tibuski/project-zomboid-server-docker"
LABEL org.opencontainers.image.licenses="MIT"
LABEL org.opencontainers.image.authors="tibuski"

COPY --from=builder /discordbot /usr/local/bin/discordbot

ENTRYPOINT ["/usr/local/bin/discordbot"]
